# Backend (server/index.js) — не попадает во фронтенд

TELEGRAM_BOT_TOKEN=

# Включить Telegram-бота для продажи услуг (polling). Не запускайте несколько копий с true.
TELEGRAM_BOT_ENABLED=false

TELEGRAM_CHAT_ID=

# Webhook MAX (если подключён у компании); иначе оставьте пустым

MAX_WEBHOOK_URL=

MAX_API_TOKEN=

PORT=3001

# Production (VPS/Docker): PORT=8080, HOST=0.0.0.0, NODE_ENV=production
# NODE_ENV=production

HOST=0.0.0.0

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002,https://01-service.ru,https://www.01-service.ru

# Public site URL for sitemap/robots, e.g. https://your-domain.example (leave empty to use request host)
PUBLIC_SITE_URL=

# Публичная ссылка на бота; показывается на сайте и в сообщении о майнерах.
PUBLIC_TELEGRAM_BOT_URL=



# Frontend (Create React App)

REACT_APP_TELEGRAM_URL=

# Ссылка на чат MAX (Профиль → Пригласить друзей), не по номеру телефона
REACT_APP_MAX_CHAT_URL=

REACT_APP_LEAD_API_URL=/api/leads



# Ключ JavaScript API — публичный, ограничьте его HTTP Referrer своим доменом.
# Яндекс.Карты (frontend, developer.tech.yandex.ru). В Referrer добавьте домен сайта.

REACT_APP_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# Серверный ключ Геокодера для запасного определения адреса; хранится только в backend-окружении.
YANDEX_GEOCODER_API_KEY=



# Яндекс.Метрика (подключается после «Принять» в баннере cookie)
REACT_APP_YANDEX_METRIKA_ID=

# Администратор (/admin). Создайте bcrypt-хеш командой npm run admin:hash-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash

# PostgreSQL
DATABASE_URL=postgresql://saytpraktika_app:replace-this-with-random-password@127.0.0.1:5434/saytpraktika
DATABASE_SSL=false

# Docker Compose PostgreSQL credentials (use a unique random value)
POSTGRES_DB=saytpraktika
POSTGRES_USER=saytpraktika_app
# Для локального Docker: тот же пароль, что в DATABASE_URL выше
POSTGRES_PASSWORD=replace-this-with-random-password

# Docker Compose выполняет дамп PostgreSQL при старте и затем ежедневно.
# Храните ./backups вне репозитория; для production задайте отдельный защищённый диск.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

