# Backend (server/index.js) — не попадает во фронтенд

TELEGRAM_BOT_TOKEN=123456789:AAExampleReplaceMe

TELEGRAM_CHAT_ID=-1001234567890

# Webhook MAX (если подключён у компании); иначе оставьте пустым

MAX_WEBHOOK_URL=

MAX_API_TOKEN=

PORT=3001

# Production (VPS/Docker): PORT=8080, HOST=0.0.0.0, NODE_ENV=production
# NODE_ENV=production

HOST=0.0.0.0

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002,https://01-service.ru,https://www.01-service.ru



# Frontend (Create React App)

REACT_APP_TELEGRAM_URL=https://t.me/Litwin4all

# Ссылка на чат MAX (Профиль → Пригласить друзей), не по номеру телефона
REACT_APP_MAX_CHAT_URL=https://max.ru/u/ВАШ_КОД_ИЗ_MAX

REACT_APP_LEAD_API_URL=/api/leads



# Яндекс.Карты (геокодер в форме заказа). В developer.tech.yandex.ru ограничьте ключ HTTP Referrer вашим доменом.

# Ключ JavaScript API и HTTP Геокодера (developer.tech.yandex.ru). В Referrer добавьте http://localhost:* и http://127.0.0.1:*
REACT_APP_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key



# Соль для демо-хеша паролей в localStorage (не замена серверной авторизации)

REACT_APP_AUTH_PEPPER=change-me-in-production

# Яндекс.Метрика (подключается после «Принять» в баннере cookie)
REACT_APP_YANDEX_METRIKA_ID=

# Упрощённая админ-панель (/admin). Пароль хранится только в виде scrypt-хеша.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=salt:scrypt_hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://saytpraktika_app:password@127.0.0.1:5434/saytpraktika
DATABASE_SSL=false

# Docker Compose PostgreSQL credentials (use a unique random value)
POSTGRES_DB=saytpraktika
POSTGRES_USER=saytpraktika_app
# Для локального Docker: тот же пароль, что в DATABASE_URL выше
POSTGRES_PASSWORD=password

