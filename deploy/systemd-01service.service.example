[Unit]
Description=01 SERVICE — Node API + static
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/01service
EnvironmentFile=/var/www/01service/.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
