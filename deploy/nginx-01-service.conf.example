# Пример для VPS: TLS + прокси на Node (Docker :8080 или systemd :8080)
# Скопируйте в /etc/nginx/sites-available/01-service и включите site.

server {
    listen 80;
    server_name 01-service.ru www.01-service.ru;
    return 301 https://01-service.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.01-service.ru;
    ssl_certificate     /etc/letsencrypt/live/01-service.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/01-service.ru/privkey.pem;
    return 301 https://01-service.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name 01-service.ru;

    ssl_certificate     /etc/letsencrypt/live/01-service.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/01-service.ru/privkey.pem;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
